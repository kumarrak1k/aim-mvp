# =============================================================================
# AI Career Mentor — required environment variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# =============================================================================

# --- OpenAI (TTS, question generation, feedback, voice/video analysis) -------
OPENAI_API_KEY=sk-proj-...

# --- Clerk (authentication) ---------------------------------------------------
# Get from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Clerk redirect URLs (usually left as default but can be overridden)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/practice
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/practice

# --- Stripe (billing) ---------------------------------------------------------
# Get from https://dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Webhook secrets — from https://dashboard.stripe.com → Webhooks
# One webhook for candidate billing, one for corporate/company billing
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_WEBHOOK_SECRET_CORPORATE=whsec_...

# Stripe Price IDs — candidate plans (must match exactly what app/lib/stripe.ts reads)
STRIPE_PRICE_PLUS_MONTHLY=price_...
STRIPE_PRICE_PLUS_ANNUAL=price_...
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_...
STRIPE_PRICE_PROFESSIONAL_ANNUAL=price_...

# Stripe Price IDs — corporate plans (all four are read by the app; annual
# purchases/upgrades 503 if the *_ANNUAL ones are unset)
STRIPE_PRICE_CORPORATE_TEAM_MONTHLY=price_...
STRIPE_PRICE_CORPORATE_TEAM_ANNUAL=price_...
STRIPE_PRICE_CORPORATE_BUSINESS_MONTHLY=price_...
STRIPE_PRICE_CORPORATE_BUSINESS_ANNUAL=price_...

# Must be "true" for the in-app upgrade / subscribe buttons to render
NEXT_PUBLIC_PAYMENTS_ENABLED=true

# --- Database (Neon PostgreSQL) -----------------------------------------------
# Pooled connection (used by the app at runtime).
# IMPORTANT for serverless scale: append pgbouncer=true&connection_limit=1 so
# Prisma is PgBouncer-safe (no prepared-statement errors under load) and each
# lambda opens at most one backend connection. Do NOT put channel_binding on
# the POOLED url (it doesn't negotiate through PgBouncer with Prisma's engine).
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require&pgbouncer=true&connection_limit=1
# Direct connection (used by Prisma migrations only — non-pooler host)
DIRECT_URL=postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require

# --- Cron (Vercel Cron → /api/cron/nurture) ----------------------------------
# REQUIRED in production: the nurture cron now fails CLOSED without it. Vercel
# injects this as the "Authorization: Bearer <CRON_SECRET>" header on schedule.
CRON_SECRET=

# --- Upstash Redis (rate limiting) -------------------------------------------
# Get from https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# --- Resend (transactional email) --------------------------------------------
# Get from https://resend.com → API Keys
RESEND_API_KEY=re_...
# The From address for outbound emails (must be a verified domain in Resend)
EMAIL_FROM=AI Career Mentor <noreply@aicareermentor.co.uk>

# --- Azure Speech (optional — voice analysis fallback) -----------------------
# Not required if you're not using Azure Speech Services
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Sentry (error monitoring) -----------------------------------------------
# Get from https://sentry.io → Settings → Projects → Client Keys (DSN)
# Set both to the same DSN value from your Sentry project.
# Leave blank to disable Sentry (safe for local dev).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Required for source map uploads during Vercel build
# Get from https://sentry.io → Settings → Auth Tokens
SENTRY_AUTH_TOKEN=

# --- Site URL (used in emails, sitemaps, structured data) --------------------
NEXT_PUBLIC_SITE_URL=https://aicareermentor.co.uk
