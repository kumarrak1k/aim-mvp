generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PracticeSession {
  id                String   @id @default(cuid())
  clerkUserId       String
  role              String
  experienceLevel   String
  interviewType     String
  difficulty        String
  focusArea         String
  practiceMode      String
  totalQuestions    Int
  overallScore      Int
  hireSignal        String
  summary           Json
  results           Json
  speakerPreference Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([clerkUserId])
  @@index([createdAt])
}

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  industry    String?
  logoUrl     String?
  brandColor  String   @default("#8c5cff")

  // Subscription / plan
  planId                 String?   // "team" | "business" | "enterprise"
  planStatus             String    @default("none") // "none" | "trial" | "active" | "expired" | "cancelled"
  trialEndsAt            DateTime?
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  stripeCurrentPeriodEnd DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     CompanyMember[]
  templates   AssessmentTemplate[]
  assignments CandidateAssignment[]
  invites     CompanyInvite[]
  apiKeys     ApiKey[]

  @@index([slug])
}

model ApiKey {
  id         String    @id @default(cuid())
  companyId  String
  name       String
  keyHash    String    @unique
  keyPrefix  String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model CompanyMember {
  id          String   @id @default(cuid())
  companyId   String
  clerkUserId String
  role        String   @default("recruiter")
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, clerkUserId])
  @@index([clerkUserId])
  @@index([companyId])
}

model CompanyInvite {
  id        String   @id @default(cuid())
  companyId String
  email     String
  role      String   @default("recruiter")
  token     String   @unique @default(cuid())
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([companyId])
}

model AssessmentTemplate {
  id                  String   @id @default(cuid())
  companyId           String
  name                String
  description         String?
  role                String
  experienceLevel     String   @default("Graduate / entry level")
  // templateType: "interview" | "assessment-centre"
  templateType        String   @default("interview")
  // acStages: subset of ["stage1","stage2","stage3"] — only meaningful when templateType="assessment-centre"
  acStages            String[] @default([])
  // questionMix: JSON record of QuestionMixKey→count — null means use interviewType default
  questionMix         Json?
  interviewType       String   @default("Competency / behavioural")
  difficulty          String   @default("Standard")
  focusArea           String   @default("Balanced")
  questionCount       Int      @default(5)
  customInstructions  String?
  competencyFramework String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments CandidateAssignment[]

  @@index([companyId])
}

model CandidateAssignment {
  id              String    @id @default(cuid())
  companyId       String
  templateId      String
  candidateEmail  String
  inviteToken     String    @unique @default(cuid())
  status          String    @default("pending")
  clerkUserId     String?
  sessionId       String?   // interview-only: PracticeSession id
  acSessionId     String?   // assessment-centre: AssessmentCentreSession id
  expiresAt       DateTime
  startedAt       DateTime?
  completedAt     DateTime?
  // Email delivery tracking — populated by the Resend integration.
  emailSent       Boolean   @default(false)
  emailSentAt     DateTime?
  emailMessageId  String?
  emailError      String?
  emailSendCount  Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template AssessmentTemplate @relation(fields: [templateId], references: [id])

  @@index([companyId])
  @@index([inviteToken])
  @@index([clerkUserId])
}

model EmailJob {
  id          String    @id @default(cuid())
  userId      String
  email       String
  type        String
  scheduledAt DateTime
  sentAt      DateTime?
  status      String    @default("pending")
  attempts    Int       @default(0)
  messageId   String?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
  @@index([userId])
}

model Referral {
  id        String        @id @default(cuid())
  userId    String        @unique
  code      String        @unique
  usedCount Int           @default(0)
  createdAt DateTime      @default(now())

  uses ReferralUse[]
}

model ReferralUse {
  id         String   @id @default(cuid())
  referralId String
  newUserId  String
  createdAt  DateTime @default(now())

  referral Referral @relation(fields: [referralId], references: [id])

  @@unique([referralId, newUserId])
}

model Certificate {
  id       String   @id @default(cuid())
  userId   String
  name     String
  role     String
  score    Float
  issuedAt DateTime @default(now())

  @@index([userId])
}

model AssessmentCentreSession {
  id                   String    @id @default(cuid())
  clerkUserId          String

  // When created from a company invite (not self-serve), these link back to
  // the CandidateAssignment and carry the template-driven configuration.
  assignmentToken      String?   @unique  // CandidateAssignment.inviteToken
  templateConfig       Json?              // {interviewType,difficulty,focusArea,questionCount,questionMix?,customInstructions?,competencyFramework?}

  // Setup
  role                 String
  sector               String
  experienceLevel      String
  selectedStages       String[]  @default(["stage1", "stage2", "stage3"])

  // Progress
  status               String    @default("setup")
  currentStage         Int       @default(1)

  // Stage 1 — Case study
  caseStudyScenario    Json?
  caseStudyResponse    String?   @db.Text
  caseStudyFeedback    Json?
  caseStudyScore       Float?
  caseStudyTimeMs      Int?

  // Stage 2 — Competency interview
  interviewResults     Json?
  interviewSummary     Json?
  interviewScore       Float?

  // Stage 3 — Presentation
  presentationBrief    Json?
  presentationResponse String?   @db.Text
  presentationFeedback Json?
  presentationScore    Float?

  // Final report
  overallScore         Float?
  report               Json?
  completedAt          DateTime?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([clerkUserId])
  @@index([status])
}

model UserProfile {
  id                    String   @id @default(cuid())
  clerkUserId           String   @unique
  cvText                String   @default("") @db.Text
  roleSpec              String   @default("") @db.Text
  interviewGoals        String   @default("")
  cvFileName            String   @default("")
  roleSpecFileName      String   @default("")
  preferredPracticeMode String   @default("typed")
  speakerPreference     Json     @default("{\"voice\":\"female\",\"accent\":\"british\",\"pace\":\"natural\"}")
  defaultExperienceLevel String  @default("Graduate / entry level")
  defaultInterviewType  String   @default("Competency / behavioural")
  defaultDifficulty     String   @default("Standard")
  defaultFocusArea      String   @default("Balanced")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([clerkUserId])
}
