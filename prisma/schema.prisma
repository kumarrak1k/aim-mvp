generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PracticeSession {
  id                String   @id @default(cuid())
  clerkUserId       String
  role              String
  experienceLevel   String
  interviewType     String
  difficulty        String
  focusArea         String
  practiceMode      String
  totalQuestions    Int
  overallScore      Int
  hireSignal        String
  summary           Json
  results           Json
  speakerPreference Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([clerkUserId])
  @@index([createdAt])
  // Supports the trial/free usage windowed count (clerkUserId + createdAt >= start)
  // and the dashboard list (clerkUserId, newest first).
  @@index([clerkUserId, createdAt])
}

/**
 * One row per career-doc generation (CV enhancer, personal statement, cover
 * letter). Doubles as a generation log and as the counter for the free-trial
 * fair-usage cap (counted since the user's trial start).
 */
model CareerDocGeneration {
  id          String   @id @default(cuid())
  clerkUserId String
  kind        String // "cv-enhancer" | "personal-statement" | "cover-letter"
  createdAt   DateTime @default(now())

  @@index([clerkUserId, createdAt])
}

/**
 * Candidate email / notification consent. Marketing & nurture emails are only
 * sent when marketingConsent is true; transactional emails ignore this.
 * unsubscribeToken powers one-click List-Unsubscribe links (no login needed).
 */
model EmailPreference {
  id               String   @id @default(cuid())
  clerkUserId      String   @unique
  email            String // snapshot of the address at consent time
  marketingConsent Boolean  @default(false)
  unsubscribeToken String   @unique @default(uuid())
  consentSource    String   @default("signup") // "signup" | "preferences" | "unsubscribe"
  consentUpdatedAt DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([clerkUserId])
}

/**
 * One row per normalized email that has ever been granted a candidate free
 * trial. Stops trial-farming via plus-tags / dot tricks / fresh accounts —
 * the email is normalized then SHA-256 hashed (we never store the address).
 */
model TrialGrant {
  id          String   @id @default(cuid())
  emailHash   String   @unique
  clerkUserId String
  createdAt   DateTime @default(now())

  @@index([clerkUserId])
}

/**
 * Email addresses to never send to again — populated by the Resend webhook on
 * hard bounces and spam complaints. Protects sender reputation.
 */
model SuppressedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String // "bounced" | "complained"
  createdAt DateTime @default(now())
}

/**
 * Idempotency ledger for Stripe webhooks. Stripe guarantees at-least-once
 * delivery and retries on any non-2xx, so every handler must dedupe on the
 * event id before processing.
 */
model ProcessedStripeEvent {
  id        String   @id // Stripe event id (evt_...)
  type      String
  createdAt DateTime @default(now())
}

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  industry    String?
  logoUrl     String?
  brandColor  String   @default("#8c5cff")

  // Subscription / plan
  planId                 String?   // "team" | "business" | "enterprise"
  planStatus             String    @default("none") // "none" | "trial" | "comp" | "active" | "expired" | "cancelled"
  trialStartedAt         DateTime?
  trialEndsAt            DateTime?
  compUntil              DateTime? // admin-granted complimentary access ends (planStatus "comp")
  trialInvitesUsed       Int       @default(0) // candidate invites consumed during a self-serve trial
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  stripeCurrentPeriodEnd DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     CompanyMember[]
  templates   AssessmentTemplate[]
  assignments CandidateAssignment[]
  invites     CompanyInvite[]
  apiKeys     ApiKey[]

  @@index([slug])
}

model ApiKey {
  id         String    @id @default(cuid())
  companyId  String
  name       String
  keyHash    String    @unique
  keyPrefix  String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model CompanyMember {
  id          String   @id @default(cuid())
  companyId   String
  clerkUserId String
  role        String   @default("recruiter")
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, clerkUserId])
  @@index([clerkUserId])
  @@index([companyId])
}

model CompanyInvite {
  id        String   @id @default(cuid())
  companyId String
  email     String
  role      String   @default("recruiter")
  token     String   @unique @default(cuid())
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([companyId])
}

model AssessmentTemplate {
  id                  String   @id @default(cuid())
  companyId           String
  name                String
  description         String?
  role                String
  experienceLevel     String   @default("Graduate / entry level")
  // templateType: "interview" | "assessment-centre"
  templateType        String   @default("interview")
  // acStages: subset of ["stage1","stage2","stage3"] — only meaningful when templateType="assessment-centre"
  acStages            String[] @default([])
  // questionMix: JSON record of QuestionMixKey→count — null means use interviewType default
  questionMix         Json?
  interviewType       String   @default("Competency / behavioural")
  difficulty          String   @default("Standard")
  focusArea           String   @default("Balanced")
  questionCount       Int      @default(5)
  customInstructions  String?
  competencyFramework String?
  // verbatim questions for "custom" mix slots — index-matched to custom slots in questionMix
  customQuestions     String[] @default([])
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments CandidateAssignment[]

  @@index([companyId])
}

model CandidateAssignment {
  id              String    @id @default(cuid())
  companyId       String
  templateId      String
  candidateEmail  String
  inviteToken     String    @unique @default(uuid())
  status          String    @default("pending")
  clerkUserId     String?
  sessionId       String?   // interview-only: PracticeSession id
  acSessionId     String?   // assessment-centre: AssessmentCentreSession id
  expiresAt       DateTime
  startedAt       DateTime?
  completedAt     DateTime?
  // Email delivery tracking — populated by the Resend integration.
  emailSent       Boolean   @default(false)
  emailSentAt     DateTime?
  emailMessageId  String?
  emailError      String?
  emailSendCount  Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Explicit cascade so a (future) direct template delete can't FK-error.
  // In normal operation templates are soft-deactivated, so assignments persist.
  template AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([inviteToken])
  @@index([clerkUserId])
}

model EmailJob {
  id          String    @id @default(cuid())
  userId      String
  email       String
  type        String
  scheduledAt DateTime
  sentAt      DateTime?
  status      String    @default("pending")
  attempts    Int       @default(0)
  messageId   String?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
  @@index([userId])
}

model Referral {
  id        String        @id @default(cuid())
  userId    String        @unique
  code      String        @unique
  usedCount Int           @default(0)
  createdAt DateTime      @default(now())

  uses ReferralUse[]
}

model ReferralUse {
  id         String   @id @default(cuid())
  referralId String
  newUserId  String
  createdAt  DateTime @default(now())

  referral Referral @relation(fields: [referralId], references: [id])

  @@unique([referralId, newUserId])
}

model Certificate {
  id       String   @id @default(cuid())
  userId   String
  name     String
  role     String
  score    Float
  issuedAt DateTime @default(now())

  @@index([userId])
}

model AssessmentCentreSession {
  id                   String    @id @default(cuid())
  clerkUserId          String

  // When created from a company invite (not self-serve), these link back to
  // the CandidateAssignment and carry the template-driven configuration.
  assignmentToken      String?   @unique  // CandidateAssignment.inviteToken
  templateConfig       Json?              // {interviewType,difficulty,focusArea,questionCount,questionMix?,customInstructions?,competencyFramework?}

  // Setup
  role                 String
  sector               String
  experienceLevel      String
  selectedStages       String[]  @default(["stage1", "stage2", "stage3"])

  // Progress
  status               String    @default("setup")
  currentStage         Int       @default(1)

  // Stage 1 — Case study
  caseStudyScenario    Json?
  caseStudyResponse    String?   @db.Text
  caseStudyFeedback    Json?
  caseStudyScore       Float?
  caseStudyTimeMs      Int?

  // Stage 2 — Competency interview
  interviewResults     Json?
  interviewSummary     Json?
  interviewScore       Float?

  // Stage 3 — Presentation
  presentationBrief    Json?
  presentationResponse String?   @db.Text
  presentationFeedback Json?
  presentationScore    Float?

  // Final report
  overallScore         Float?
  report               Json?
  completedAt          DateTime?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([clerkUserId])
  @@index([status])
}

model UserProfile {
  id                    String   @id @default(cuid())
  clerkUserId           String   @unique
  cvText                String   @default("") @db.Text
  roleSpec              String   @default("") @db.Text
  interviewGoals        String   @default("")
  cvFileName            String   @default("")
  roleSpecFileName      String   @default("")
  preferredPracticeMode String   @default("typed")
  speakerPreference     Json     @default("{\"voice\":\"female\",\"accent\":\"british\",\"pace\":\"natural\"}")
  defaultExperienceLevel String  @default("Graduate / entry level")
  defaultInterviewType  String   @default("Competency / behavioural")
  defaultDifficulty     String   @default("Standard")
  defaultFocusArea      String   @default("Balanced")
  defaultTotalQuestions Int      @default(5)
  defaultUseHybridMix   Boolean  @default(false)
  defaultQuestionMix    Json?
  tosAcceptedAt         DateTime?
  tosAcceptedVersion    String?
  // First-touch signup attribution (captured on landing, saved at signup).
  utmSource             String?
  utmMedium             String?
  utmCampaign           String?
  promoCode             String?
  referrer              String?
  landingPath           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([clerkUserId])
}

model TermsAcceptance {
  id          String   @id @default(cuid())
  clerkUserId String
  version     String
  acceptedAt  DateTime @default(now())
  ipAddress   String?
  userAgent   String?  @db.Text

  @@index([clerkUserId])
  @@index([version])
}
